{
  "name": "nodedance-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts --outDir ../internal/core/webassets/dist --emptyOutDir",
    "typecheck": "node scripts/check-i18n.cjs && node --experimental-strip-types scripts/check-session-device.cjs && node scripts/check-operations.cjs && node scripts/file-notices.cjs --check && tsc --noEmit --project tsconfig.json",
    "audit:design": "node scripts/audit-design.cjs",
    "audit:accounts": "pnpm build && node scripts/audit-accounts.cjs",
    "audit:interfaces": "pnpm build && node scripts/audit-interfaces.cjs",
    "audit:guest": "pnpm build && node scripts/audit-guest.cjs",
    "audit:guest-security": "pnpm build && NODEDANCE_GUEST_ATTACKS=1 node scripts/audit-guest.cjs",
    "audit:files": "pnpm build && node scripts/audit-files.cjs",
    "check:file-notices": "node scripts/file-notices.cjs --check",
    "audit:feeds": "pnpm build && node scripts/audit-feeds.cjs"
  },
  "dependencies": {
    "@preact/signals-react": "3.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "echarts": "6.1.0",
    "framer-motion": "14.2.0",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/jquery": "3.5.34",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
