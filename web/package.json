{
  "name": "nodedance-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts --outDir ../internal/core/webassets/dist --emptyOutDir",
    "typecheck": "node scripts/check-i18n.cjs && node --experimental-strip-types scripts/check-session-device.cjs && node --experimental-strip-types scripts/check-configuration-diff.mjs && node --experimental-strip-types scripts/check-path-display.mjs && node --experimental-strip-types scripts/check-code-editor.mjs && node scripts/check-operations.cjs && node scripts/file-notices.cjs --check && tsc --noEmit --project tsconfig.json",
    "audit:radii": "tailwindcss-concentric audit src",
    "audit:accounts": "node scripts/audit-accounts.cjs",
    "audit:interfaces": "node scripts/audit-interfaces.cjs",
    "audit:hosts": "NODEDANCE_AUDIT_HOSTS_ONLY=1 node scripts/audit-interfaces.cjs",
    "audit:alerts": "NODEDANCE_AUDIT_ALERTS_ONLY=1 node scripts/audit-interfaces.cjs",
    "audit:operations": "NODEDANCE_AUDIT_OPERATIONS_ONLY=1 node scripts/audit-interfaces.cjs",
    "audit:guest": "node scripts/audit-guest.cjs",
    "audit:guest-security": "NODEDANCE_GUEST_ATTACKS=1 node scripts/audit-guest.cjs",
    "audit:files": "node scripts/audit-files.cjs",
    "check:file-notices": "node scripts/file-notices.cjs --check",
    "audit:feeds": "node scripts/audit-feeds.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@preact/signals-react": "3.12.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "cobe": "2.0.1",
    "codemirror": "^6.0.2",
    "diff": "9.0.0",
    "echarts": "6.1.0",
    "framer-motion": "14.2.0",
    "jquery": "3.7.1",
    "jquery-ui-dist": "1.13.3",
    "lucide-react": "^1.59.0",
    "motion": "14.2.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-concentric": "0.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
